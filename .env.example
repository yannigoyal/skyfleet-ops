# Required: OpenRouter API key for the AI flight director chat functionality
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional: URL of a real MAVLink telemetry gateway bridge
# If not set, the built-in fleet simulator is used (recommended for most users)
MAVLINK_GATEWAY_URL=

# Optional: set to "true" for deterministic mock LLM responses (testing)
LLM_MOCK=true
